#!/bin/bash
# Manage an unsigned AeroSpace debug build as a per-user LaunchAgent.

set -euo pipefail

label=bobko.aerospace.debug
repo_url=${AEROSPACE_REPO_URL:-https://github.com/Jamie-Cui/AeroSpace.git}
repo_branch=${AEROSPACE_REPO_BRANCH:-main}
source_dir=${AEROSPACE_SOURCE_DIR:-"$HOME/opt/aerospace-src"}
install_dir=${AEROSPACE_INSTALL_DIR:-"$HOME/.local/libexec/aerospace-debug"}
bin_dir=${AEROSPACE_BIN_DIR:-"$HOME/.local/bin"}
launch_agents_dir=${AEROSPACE_LAUNCH_AGENTS_DIR:-"$HOME/Library/LaunchAgents"}
log_dir=${AEROSPACE_LOG_DIR:-"$HOME/Library/Logs/AeroSpace-Debug"}
app_path=$install_dir/AeroSpaceApp
cli_path=$bin_dir/aerospace-debug
plist_path=$launch_agents_dir/$label.plist
stdout_path=$log_dir/stdout.log
stderr_path=$log_dir/stderr.log
launchctl_bin=${AEROSPACE_LAUNCHCTL:-/bin/launchctl}
open_bin=${AEROSPACE_OPEN:-/usr/bin/open}
domain=gui/$(id -u)
service_target=$domain/$label
temporary_paths=("")

homebrew_prefix=${AEROSPACE_BREW_PREFIX:-}
if [ -z "$homebrew_prefix" ] && command -v brew >/dev/null 2>&1; then
	homebrew_prefix=$(brew --prefix)
fi
if [ -z "$homebrew_prefix" ]; then
	homebrew_prefix=/opt/homebrew
fi

say() { printf '%s\n' "$*"; }
die() { printf 'aerospace-service: %s\n' "$*" >&2; exit 1; }

cleanup() {
	for path in "${temporary_paths[@]}"; do
		[ -n "$path" ] || continue
		/bin/rm -f -- "$path"
	done
}
trap cleanup EXIT HUP INT TERM

usage() {
	cat <<'EOF'
Usage: aerospace-service COMMAND

Commands:
  install        Clone if needed, build, deploy, enable, and start
  update         Fast-forward the clean source checkout, then install
  rebuild        Rebuild, deploy, and restart without updating source
  enable         Enable at login and start now
  disable        Stop and disable at login
  start          Start the installed LaunchAgent
  stop           Stop it for the current login session
  restart        Restart it
  status         Print launchd service state
  logs           Follow stdout and stderr logs
  accessibility  Open Accessibility privacy settings
  uninstall      Disable and remove deployed files; keep source and logs
  help            Show this help

Environment overrides:
  AEROSPACE_SOURCE_DIR, AEROSPACE_INSTALL_DIR, AEROSPACE_BIN_DIR,
  AEROSPACE_LAUNCH_AGENTS_DIR, AEROSPACE_LOG_DIR, AEROSPACE_BASH
EOF
}

require_macos() {
	[ "$(uname -s)" = Darwin ] || die "LaunchAgent management is supported only on macOS"
}

validate_checkout() {
	[ -d "$source_dir/.git" ] || die "$source_dir exists but is not a Git checkout"
	remote=$(git -C "$source_dir" remote get-url origin 2>/dev/null) || die "cannot read AeroSpace origin"
	case "$remote" in
		https://github.com/Jamie-Cui/AeroSpace.git|https://github.com/Jamie-Cui/AeroSpace|git@github.com:Jamie-Cui/AeroSpace.git|git@github.com:Jamie-Cui/AeroSpace) ;;
		*) die "$source_dir origin is not Jamie-Cui/AeroSpace: $remote" ;;
	esac
}

ensure_checkout() {
	if [ ! -e "$source_dir" ]; then
		mkdir -p "$(dirname "$source_dir")"
		git clone --branch "$repo_branch" --single-branch --depth 1 "$repo_url" "$source_dir"
	fi
	validate_checkout
}

update_source() {
	ensure_checkout
	[ -z "$(git -C "$source_dir" status --porcelain)" ] || die "$source_dir has local changes; refusing to update"
	git -C "$source_dir" fetch origin "$repo_branch"
	git -C "$source_dir" merge --ff-only "origin/$repo_branch"
}

resolve_bash() {
	if [ -n "${AEROSPACE_BASH:-}" ]; then
		bash_bin=$AEROSPACE_BASH
	elif [ -x "$homebrew_prefix/bin/bash" ]; then
		bash_bin=$homebrew_prefix/bin/bash
	else
		bash_bin=$(command -v bash || true)
	fi
	[ -n "$bash_bin" ] && [ -x "$bash_bin" ] || die "Bash 5 is required; run: brew install bash"
	"$bash_bin" --version | head -1 | grep -Eq 'version ([5-9]|[1-9][0-9]+)\.' || \
		die "Bash 5 is required; run: brew install bash"
}

build_debug() {
	ensure_checkout
	resolve_bash
	(
		cd "$source_dir"
		PATH="$homebrew_prefix/bin:$PATH" "$bash_bin" ./build-debug.sh
	)
	[ -x "$source_dir/.debug/AeroSpaceApp" ] || die "debug app was not produced"
	[ -x "$source_dir/.debug/aerospace" ] || die "debug CLI was not produced"
}

atomic_install() {
	source=$1
	destination=$2
	mkdir -p "$(dirname "$destination")"
	temporary=$(mktemp "$destination.tmp.XXXXXX")
	temporary_paths[${#temporary_paths[@]}]=$temporary
	/usr/bin/install -m 0755 "$source" "$temporary"
	/bin/mv -f "$temporary" "$destination"
}

deploy_debug() {
	atomic_install "$source_dir/.debug/AeroSpaceApp" "$app_path"
	atomic_install "$source_dir/.debug/aerospace" "$cli_path"
}

write_plist() {
	mkdir -p "$launch_agents_dir" "$log_dir"
	temporary=$(mktemp "$plist_path.tmp.XXXXXX")
	temporary_paths[${#temporary_paths[@]}]=$temporary

	/usr/bin/plutil -create xml1 "$temporary"
	/usr/bin/plutil -insert Label -string "$label" "$temporary"
	/usr/bin/plutil -insert ProgramArguments -array "$temporary"
	/usr/bin/plutil -insert ProgramArguments.0 -string "$app_path" "$temporary"
	/usr/bin/plutil -insert WorkingDirectory -string "$source_dir" "$temporary"
	/usr/bin/plutil -insert RunAtLoad -bool true "$temporary"
	/usr/bin/plutil -insert ProcessType -string Interactive "$temporary"
	/usr/bin/plutil -insert LimitLoadToSessionType -string Aqua "$temporary"
	/usr/bin/plutil -insert StandardOutPath -string "$stdout_path" "$temporary"
	/usr/bin/plutil -insert StandardErrorPath -string "$stderr_path" "$temporary"
	/usr/bin/plutil -insert EnvironmentVariables -dictionary "$temporary"
	/usr/bin/plutil -insert EnvironmentVariables.PATH -string \
		"$bin_dir:$homebrew_prefix/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" "$temporary"
	/usr/bin/plutil -lint "$temporary" >/dev/null
	/bin/mv -f "$temporary" "$plist_path"
}

is_loaded() {
	"$launchctl_bin" print "$service_target" >/dev/null 2>&1
}

start_service() {
	[ -x "$app_path" ] || die "$app_path is missing; run: aerospace-service install"
	[ -f "$plist_path" ] || die "$plist_path is missing; run: aerospace-service install"
	mkdir -p "$log_dir"
	if ! is_loaded; then
		"$launchctl_bin" bootstrap "$domain" "$plist_path"
	fi
	"$launchctl_bin" kickstart -k "$service_target"
	say "Started $service_target"
}

stop_service() {
	if is_loaded; then
		"$launchctl_bin" bootout "$service_target"
		say "Stopped $service_target"
	else
		say "$service_target is not loaded"
	fi
}

enable_service() {
	"$launchctl_bin" enable "$service_target"
	start_service
	say "Enabled $service_target at login"
}

disable_service() {
	if is_loaded; then
		"$launchctl_bin" bootout "$service_target"
	fi
	"$launchctl_bin" disable "$service_target"
	say "Disabled $service_target"
}

reload_service() {
	if is_loaded; then
		"$launchctl_bin" bootout "$service_target"
	fi
	"$launchctl_bin" enable "$service_target"
	"$launchctl_bin" bootstrap "$domain" "$plist_path"
	"$launchctl_bin" kickstart -k "$service_target"
}

install_service() {
	build_debug
	deploy_debug
	write_plist
	reload_service
	say "Installed and started unsigned AeroSpace debug service"
	say "Executable: $app_path"
	say "CLI: $cli_path"
	say "Grant Accessibility permission if prompted; unsigned rebuilds may require granting it again."
}

status_service() {
	say "Executable: $app_path"
	say "LaunchAgent: $plist_path"
	if is_loaded; then
		"$launchctl_bin" print "$service_target"
	else
		say "$service_target is not loaded"
		return 3
	fi
}

follow_logs() {
	mkdir -p "$log_dir"
	touch "$stdout_path" "$stderr_path"
	exec tail -n 100 -f "$stdout_path" "$stderr_path"
}

uninstall_service() {
	disable_service
	/bin/rm -f -- "$plist_path" "$app_path" "$cli_path"
	/bin/rmdir "$install_dir" 2>/dev/null || true
	say "Removed deployed AeroSpace debug files; kept $source_dir and $log_dir"
}

main() {
	require_macos
	case "${1:-help}" in
		install) install_service ;;
		update) update_source; install_service ;;
		rebuild) install_service ;;
		enable) enable_service ;;
		disable) disable_service ;;
		start) start_service ;;
		stop) stop_service ;;
		restart) stop_service; start_service ;;
		status) status_service ;;
		logs) follow_logs ;;
		accessibility)
			"$open_bin" 'x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility'
			say "Add or enable: $app_path"
			;;
		uninstall) uninstall_service ;;
		help|-h|--help) usage ;;
		*) usage >&2; die "unknown command: $1" ;;
	esac
}

main "$@"
