[general]
status_path = "~/.local/state/vdirsyncer/status/"

[pair org_project_caldav]
a = "org_project_caldav_remote"
b = "org_project_caldav_local"
collections = null
conflict_resolution = "b wins"

[storage org_project_caldav_remote]
type = "caldav"
url = "https://caldav.gw-api.xyz/jamie/org-tasks/"
username.fetch = ["command", "printenv", "ORG_PROJECT_CALDAV_USERNAME"]
password.fetch = ["command", "printenv", "ORG_PROJECT_CALDAV_PASSWORD"]
item_types = ["VTODO"]

[storage org_project_caldav_local]
type = "filesystem"
path = "~/.local/share/org-project-caldav/org-tasks/"
fileext = ".ics"
