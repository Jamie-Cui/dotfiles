##########################################################################

# themes
# include ./themes/zenburn.conf
# include ./themes/modus-vivendi.conf
include ./themes/gruvbox-dark.conf

# shell config
# shell /bin/zsh

# Keep a beam cursor at shell prompts, including across plain SSH sessions.
# Cursor switching is the only disabled shell-integration feature.
cursor_shape beam
shell_integration enabled no-cursor

# terminal opacity and blur
# background_opacity 1
# background_blur 1

# advance
# term xterm-kitty

# terminal bell
enable_audio_bell no

allow_remote_control yes

listen_on unix:/tmp/mykitty

# Keep Option available for native macOS input. Command is Meta on macOS;
# the Alt key immediately left of Space is Meta on the Linux HHKB.
macos_option_as_alt no

# Forward the Meta bindings used by Neovim as terminal Alt/Meta sequences.
map @KITTY_META_MOD@+a     send_text all \x1ba
map @KITTY_META_MOD@+c     send_text all \x1bc
map @KITTY_META_MOD@+d     send_text all \x1bd
map @KITTY_META_MOD@+f     send_text all \x1bf
map @KITTY_META_MOD@+i     send_text all \x1bi
map @KITTY_META_MOD@+s     send_text all \x1bs
map @KITTY_META_MOD@+v     send_text all \x1bv
map @KITTY_META_MOD@+w     send_text all \x1bw
map @KITTY_META_MOD@+x     send_text all \x1bx
map @KITTY_META_MOD@+y     send_text all \x1by
map @KITTY_META_MOD@+slash send_text all \x1b/
map @KITTY_META_MOD@+enter send_text all \x1b\x0d

# Restore the platform clipboard shortcuts after the Meta mappings above.
# On macOS, copy_or_noop preserves Command+C pass-through when nothing is selected.
map @KITTY_CLIPBOARD_MOD@+c @KITTY_COPY_ACTION@
map @KITTY_CLIPBOARD_MOD@+v paste_from_clipboard

# Allow OSC 52 writes; keep clipboard reads behind Kitty's permission prompt.
clipboard_control write-clipboard write-primary read-clipboard-ask read-primary-ask

# os specific tweaks (Gnome window decoration for wayland)
# linux_display_server x11

# font
font_family        Maple Mono NL NF CN
bold_font          auto
italic_font        auto
bold_italic_font   auto
font_size @FONT_SIZE@

# font size shortcuts (Command on macOS, Alt immediately left of Space on Linux HHKB)
map ctrl+@KITTY_META_MOD@+minus change_font_size all -1.0
map ctrl+@KITTY_META_MOD@+equal change_font_size all +1.0

hide_window_decorations yes
